.DS_Store
node_modules/
*.log
.env
ai-flows/*.html
# Built surfaces. CI builds them to /tmp and checks those; the published copy
# lives in the website repository. A tracked copy means every rebuild is a diff
# of a hundred kilobytes of generated markup that nobody reviews.
ai-ui/*.html
/*.html
ai-base/data-*/
.run/

# Editable installs leave these next to the source. `projects/coclea-sr` ignores
# `.venv/` and `__pycache__/` already; `hemo-verified` had no manifest at all
# until 2026-08-23 and so had never produced one.
*.egg-info/
.venv/
__pycache__/
*.pyc
